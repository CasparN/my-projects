---
import Photo from "./Photo.astro";
import { getEntry } from "astro:content";
import JournalMeta from "./JournalMeta.astro";
import { getJournalPosts } from "../lib/journal";
import { paragraphs, projects, html, url, lastUpdated } from "../lib/site";
const journalPosts = await getJournalPosts();
const homePage = await getEntry("pages", "index");
const featuredJournal = homePage?.data.featuredJournal;
const journalPost =
  featuredJournal === "none"
    ? undefined
    : (journalPosts.find((post) => post.id === featuredJournal) ??
      journalPosts[0]);
const journalUrl = journalPost ? url("journal/" + journalPost.id) : "";
const updatedLabel = new Intl.DateTimeFormat("nl-NL", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${lastUpdated}T12:00:00Z`));
---

<section class="field-intro">
  <div class="field-copy">
    <>
      <span class="eyebrow">
        Laatst bijgewerkt /{" "}
        <time datetime={lastUpdated}>{updatedLabel}</time>
      </span>
      <h1>Caspar Niekus.</h1>
      <div class="intro" set:html={html(paragraphs[0])} />
      <a class="text-link" href="#projects"> Bekijk mijn projecten ↓ </a>
    </>
  </div>
  <div class="field-photos">
    <figure class="field-landscape">
      <>
        <Photo
          name="mountain-path"
          alt="Een wandelpad door open berglandschap, met een meer tussen de heuvels"
          eager
        />
      </>
    </figure>
    {
      journalPost && (
        <a class="field-object" href={journalUrl}>
          <>
            <Photo
              name={journalPost.data.cover}
              alt={journalPost.data.coverAlt}
              eager
            />
            <span>{journalPost.data.title} ↗</span>
          </>
        </a>
      )
    }
  </div>
</section>
<section class="projects-section" id="projects">
  <div class="section-heading">
    <span class="eyebrow">01 / Projecten</span><a
      class="text-link"
      href={url("projects")}>Alle projecten ↗</a
    >
  </div>
  <div class="project-grid">
    {
      projects.map((project, index) => (
        <a
          class:list={[
            "project-card",
            { "project-card-note": project.picture === "research" },
          ]}
          href={url(project.path)}
        >
          {project.picture !== "research" ? (
            <div class="project-photo">
              <Photo
                name={project.picture}
                alt={project.title}
                sizes="(max-width: 760px) 100vw, 50vw"
              />
              <span class="project-index">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
          ) : (
            <div class="research-plate" aria-hidden="true">
              <span>05 / Onderzoek</span>
              <strong>Versterken en verstoren.</strong>
              <span>Techniek & ethiek</span>
            </div>
          )}
          <div class="project-card-copy">
            <>
              <h2>
                {project.title}
                <span aria-hidden="true">↗</span>
              </h2>
              <p>{project.description}</p>
            </>
          </div>
        </a>
      ))
    }
  </div>
</section>
{
  journalPost && (
    <section class="journal-feature">
      <a class="journal-picture" href={journalUrl}>
        <Photo name={journalPost.data.cover} alt={journalPost.data.coverAlt} />
      </a>
      <div>
        <>
          <JournalMeta
            category={journalPost.data.category}
            date={journalPost.data.date}
          />
          <h2>
            <a href={journalUrl}>{journalPost.data.title}</a>
          </h2>
          <p>{journalPost.data.description}</p>
          <a class="text-link" href={journalUrl}>
            Lees het verhaal ↗
          </a>
        </>
      </div>
    </section>
  )
}
<section class="more-about">
  <div>
    <span class="eyebrow">Over mij</span><div
      set:html={html(paragraphs[1])}
    /><div set:html={html(paragraphs[3])} /><div
      set:html={html(paragraphs[4])}
    />
  </div>
  <div class="availability" set:html={html(paragraphs[2])} />
</section>
